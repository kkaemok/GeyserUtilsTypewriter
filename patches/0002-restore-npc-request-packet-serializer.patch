diff --git a/geyser/src/main/java/me/zimzaza4/geyserutils/geyser/compat/NpcRequestCodecCompat.java b/geyser/src/main/java/me/zimzaza4/geyserutils/geyser/compat/NpcRequestCodecCompat.java
