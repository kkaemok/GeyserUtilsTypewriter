+++ b/geyser/src/main/java/me/zimzaza4/geyserutils/geyser/compat/NpcRequestCodecCompat.java
@@ -0,0 +1,59 @@
+package me.zimzaza4.geyserutils.geyser.compat;
+
+import io.netty.buffer.ByteBuf;
+import me.zimzaza4.geyserutils.geyser.GeyserUtils;
+import org.cloudburstmc.protocol.bedrock.BedrockServerSession;
+import org.cloudburstmc.protocol.bedrock.codec.BedrockCodec;
+import org.cloudburstmc.protocol.bedrock.codec.BedrockCodecHelper;
+import org.cloudburstmc.protocol.bedrock.codec.BedrockPacketDefinition;
+import org.cloudburstmc.protocol.bedrock.codec.BedrockPacketSerializer;
+import org.cloudburstmc.protocol.bedrock.codec.v448.serializer.NpcRequestSerializer_v448;
+import org.cloudburstmc.protocol.bedrock.data.PacketRecipient;
+import org.cloudburstmc.protocol.bedrock.packet.NpcRequestPacket;
+import org.geysermc.geyser.session.GeyserSession;
+
+/**
+ * Restores the vanilla NPC request decoder that Geyser replaces with its illegal-packet serializer.
+ */
+public final class NpcRequestCodecCompat {
+    private static final BedrockPacketSerializer<NpcRequestPacket> NPC_REQUEST_SERIALIZER =
+            new NpcRequestSerializer_v448() {
+                @Override
+                public void deserialize(ByteBuf buffer, BedrockCodecHelper helper, NpcRequestPacket packet) {
+                    super.deserialize(buffer, helper, packet);
+                    GeyserUtils extension = GeyserUtils.getInstance();
+                    if (extension != null) {
+                        extension.logger().info(
+                                "Decoded NpcRequestPacket: runtimeEntityId=" + packet.getRuntimeEntityId()
+                                        + ", requestType=" + packet.getRequestType()
+                                        + ", command=" + packet.getCommand()
+                                        + ", actionType=" + packet.getActionType()
+                                        + ", sceneName=" + packet.getSceneName());
+                    }
+                }
+            };
+
+    private NpcRequestCodecCompat() {
+    }
+
+    public static void install(GeyserSession session) {
+        BedrockServerSession upstream = session.getUpstream().getSession();
+        BedrockCodec codec = upstream.getCodec();
+        BedrockPacketDefinition<NpcRequestPacket> definition = codec.getPacketDefinition(NpcRequestPacket.class);
+
+        if (definition == null || definition.getRecipient() != PacketRecipient.SERVER) {
+            GeyserUtils.getInstance().logger().warning(
+                    "Cannot enable native NPC dialogue responses for Bedrock protocol "
+                            + codec.getProtocolVersion() + ": NpcRequestPacket has no serverbound definition");
+            return;
+        }
+
+        upstream.setCodec(patchCodec(codec));
+    }
+
+    static BedrockCodec patchCodec(BedrockCodec codec) {
+        return codec.toBuilder()
+                .updateSerializer(NpcRequestPacket.class, NPC_REQUEST_SERIALIZER)
+                .build();
+    }
+}
